{
  "name": "tgtv-ranking-tournament-system",
  "version": "1.0.0",
  "private": true,
  "description": "TGTV ranking, matchmaking, Approved Ops, and Kill Team challenge tracker.",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "start": "node server.js",
    "verify:migration:canonical-games": "node scripts/verify-canonical-games-migration.js",
    "test": "node --test --test-concurrency=1 \"test/unit/**/*.test.js\" \"test/integration/**/*.test.js\"",
    "test:unit": "node --test \"test/unit/**/*.test.js\"",
    "test:integration": "node --test --test-concurrency=1 \"test/integration/**/*.test.js\""
  },
  "dependencies": {
    "pg": "^8.22.0"
  }
}
